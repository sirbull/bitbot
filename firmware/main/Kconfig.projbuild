menu "BitBot hardware bring-up"
    config BITBOT_DISPLAY_ENABLED
        bool "Enable verified 8-pin ST7789 240x240 display wiring"
        default y
        help
            SCK=D8/GPIO7, SDA=D10/GPIO9, RES=D1/GPIO2, DC=D4/GPIO5, CS=D3/GPIO4.
            VCC and BL to 3V3; BL is not GPIO-driven. No SD card may be
            inserted or initialized.
    config BITBOT_DISPLAY_INVERT
        bool "Invert panel colors"
        default y
    config BITBOT_DISPLAY_BGR
        bool "Use BGR color order"
        default n
    config BITBOT_DISPLAY_Y_GAP
        int "Panel row offset (verify on the actual module)"
        range 0 80
        default 0
    config BITBOT_DISPLAY_SPI_MHZ
        int "Display SPI clock in MHz (lower it if the image glitches)"
        range 10 80
        default 40
    config BITBOT_DISPLAY_EXPRESSION_DEMO
        bool "Cycle through all facial expressions every 4 s (for tuning)"
        default n
endmenu
