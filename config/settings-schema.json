{
  "schemaVersion": 1,
  "fields": {
    "name": { "type": "string", "maxBytes": 48, "minBytes": 1, "default": "BitBot" },
    "provider": { "type": "enum", "values": ["xiaozhi", "gemini", "openai", "local"], "default": "xiaozhi" },
    "model": { "type": "string", "maxBytes": 120, "default": "" },
    "endpoint": { "type": "url", "maxBytes": 240, "default": "" },
    "language": { "type": "string", "format": "language", "maxBytes": 63, "default": "auto" },
    "personality": { "type": "string", "maxBytes": 2000, "default": "You are BitBot, a curious and friendly little companion. Keep spoken answers short and clear. Respond in the language the user speaks, Norwegian or English. Be honest when you do not know something." },
    "voice": { "type": "string", "maxBytes": 80, "default": "" },
    "speed": { "type": "number", "min": 0.75, "max": 1.25, "default": 1 },
    "pitch": { "type": "number", "min": -6, "max": 6, "default": 0 },
    "volume": { "type": "integer", "min": 0, "max": 100, "default": 50 },
    "brightness": { "type": "integer", "min": 10, "max": 100, "default": 70 },
    "idleSeconds": { "type": "integer", "min": 15, "max": 300, "default": 60 },
    "captions": { "type": "boolean", "default": true }
  }
}
